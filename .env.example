# Telegram Settings
TELEGRAM_BOT_TOKEN=your_bot_token_here
AUTHORIZED_USERS=123456789,987654321  # Comma-separated list of authorized Telegram User IDs

# MT5 Connection (OPTIONAL)
# When you start the bot, it automatically scans and displays all installed MT5 terminals for you to choose from!
# The bot will automatically use the active account already saved inside the selected terminal.
# You only need to fill these if you want to bypass the interactive selector or force a specific account:
# MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
# MT5_LOGIN=12345678
# MT5_PASSWORD=your_password
# MT5_SERVER=YourBroker-Server

# Application Settings
LOG_LEVEL=INFO
