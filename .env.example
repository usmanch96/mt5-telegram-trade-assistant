# Telegram Settings
TELEGRAM_BOT_TOKEN=your_bot_token_here
AUTHORIZED_USERS=123456789,987654321  # Comma-separated list of authorized Telegram User IDs

# MT5 Connection (OPTIONAL)
# When you start the bot, it automatically scans and displays all installed MT5 terminals for you to choose from!
# The bot will automatically use the active account already saved inside the selected terminal.
# You only need to fill these if you want to bypass the interactive selector or force a specific account:
# MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
# MT5_LOGIN=12345678
# MT5_PASSWORD=your_password
# MT5_SERVER=YourBroker-Server

# Application Settings
LOG_LEVEL=INFO

# Audio Alerts (Local PC Speaker)
# Play authentic MT5 chimes & voice announcements on fills, closes, TP & SL hits
SOUND_ALERTS_ENABLED=true
# Modes: 'voice' (voice announcement only), 'chime' (wav chime only), 'both' (wav + voice)
# Since MT5 already plays its chime, 'voice' is recommended to avoid duplicate dings
SOUND_ALERT_MODE=voice
# Optional custom sounds path (auto-discovered from MT5 terminal if left blank)
# MT5_SOUNDS_DIR=C:/Program Files/MetaTrader 5 EXNESS/Sounds

# Background Deal Watcher
# Real-time background deal monitor for broker TP/SL executions and external fills
DEAL_WATCHER_ENABLED=true
DEAL_WATCHER_INTERVAL=1.5

